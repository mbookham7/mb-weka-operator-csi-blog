# ---------------------------------------------------------------------------
# Template for .env -- THIS file is committed, .env is not
# ---------------------------------------------------------------------------
# Secrets and per-developer settings for this repo, in one place instead of
# scattered across your shell history. This file lives at the REPO ROOT; the
# Terraform is one level down in weka-eks-terraform/. Load it before running
# anything:
#
#     set -a && source .env && set +a       # from the repo root
#     set -a && source ../.env && set +a    # from inside weka-eks-terraform/
#
# `set -a` marks everything exported, which matters: Terraform only picks up
# TF_VAR_* from the ENVIRONMENT, and manifests/00-namespace-and-secrets.sh
# reads exported QUAY_* variables. A plain `source` without `set -a` leaves
# them as shell-local and both will appear unset.
#
# Copy to .env and fill in:  cp .env.example .env
# Values here are placeholders, not credentials.
# ---------------------------------------------------------------------------

# --- Terraform variables ---------------------------------------------------
# Terraform maps TF_VAR_<name> onto the variable <name>, so this is an
# alternative to putting the token in weka-eks-terraform/terraform.tfvars.
# Prefer this one: it
# keeps the only genuinely secret Terraform input out of any file that a
# stray `git add -f` could catch.
#
# From https://get.weka.io -- log in and copy your token.
TF_VAR_get_weka_io_token=REPLACE_ME

# Optional overrides for anything in variables.tf. Complex types (lists,
# maps) must be valid HCL/JSON in the value, not shell arrays:
# TF_VAR_region=eu-west-1
# TF_VAR_prefix=weka
# TF_VAR_cluster_name=poc
# TF_VAR_allow_ssh_cidrs=["203.0.113.4/32"]
# TF_VAR_eks_endpoint_public_access_cidrs=["203.0.113.4/32"]

# --- Quay.io credentials ---------------------------------------------------
# Robot account for the WEKA Operator and weka-in-container images. These come
# from WEKA Customer Success, not from a self-service signup. Read by
# manifests/00-namespace-and-secrets.sh.
QUAY_USERNAME=REPLACE_ME
QUAY_PASSWORD=REPLACE_ME

# Operator chart version. Ask Customer Success for the supported combination
# of operator version, weka-in-container image tag, and cluster release --
# all three have to line up.
WEKA_OPERATOR_VERSION=v1.16.0

# --- AWS -------------------------------------------------------------------
# Use a named profile rather than pasting keys here. If you genuinely need
# static keys, they belong in ~/.aws/credentials, not in a repo file --
# anything checked into a working tree eventually gets shared by accident.
# AWS_PROFILE=my-sandbox-profile
# AWS_REGION=eu-west-1
