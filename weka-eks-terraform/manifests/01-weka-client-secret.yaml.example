# ---------------------------------------------------------------------------
# WekaClient join credentials  (secret #1 of 2)
# ---------------------------------------------------------------------------
# This is the secret referenced by `spec.wekaSecretRef` in 03-weka-client.yaml.
# It lets the WEKA client container on each node AUTHENTICATE AND JOIN the
# backend cluster as a stateless client.
#
# It is NOT the same thing as 04-csi-api-secret.yaml. Two different components,
# two different jobs:
#
#   this file (01)  -> the weka-in-container client process, joining the
#                      cluster's data path. Needs a join-secret.
#   04-csi-api...   -> the CSI controller/node plugins, calling the WEKA
#                      REST API on port 14000 to create, resize and delete
#                      filesystem directories. Needs API endpoints.
#
# They can hold different credentials, and in production they should: the CSI
# plugin only needs an account that can manage filesystems. Getting these two
# confused -- putting endpoints in this one, or a join-secret in that one --
# is a common first-attempt failure.
#
# Copy to 01-weka-client-secret.yaml (gitignored) and fill in.
# EVERY VALUE IS BASE64. Encode with:
#
#     printf '%s' 'the-value' | base64
#
# Use printf, not echo: `echo` appends a newline, the newline is encoded too,
# and WEKA then tries to authenticate with a password ending in "\n". The
# failure looks like a wrong password, so you will not suspect the encoding.
---
apiVersion: v1
kind: Secret
metadata:
  name: weka-client-secret
  # Must be the same namespace as the WekaClient CR in 03-weka-client.yaml.
  namespace: weka-operator-system
type: Opaque
data:
  # --- org ---------------------------------------------------------------
  # WEKA organization to join. A cloud cluster built by the Terraform module
  # has only the default organization, "Root".
  #   printf '%s' 'Root' | base64
  org: Um9vdA==

  # --- join-secret -------------------------------------------------------
  # The cluster join token. SSH to any WEKA backend and generate one:
  #
  #     weka cluster join-token generate --access-token-timeout 52w
  #
  # 52w matters. The default token lifetime is short, and it is not just used
  # once at first join -- the client re-authenticates when its container
  # restarts, when the node is replaced, and when the operator rolls the
  # client. A short-lived token gives you a cluster that works fine for days
  # and then quietly stops admitting nodes, with new nodes failing to join and
  # no change on your side to explain it. Set it long, and set a calendar
  # reminder to rotate it.
  #
  #   printf '%s' '<token from the command above>' | base64
  join-secret: UkVQTEFDRV9XSVRIX0pPSU5fVE9LRU4=

  # --- username ----------------------------------------------------------
  # WEKA cluster user. The module-built cluster's admin user is "admin".
  # For production, create a dedicated client user rather than reusing admin.
  #   printf '%s' 'admin' | base64
  username: YWRtaW4=

  # --- password ----------------------------------------------------------
  # That user's password. For the admin user, the Terraform module stored it
  # in Secrets Manager. Fetch it with the id from `terraform output`:
  #
  #     aws secretsmanager get-secret-value \
  #       --region <region> \
  #       --secret-id "$(terraform output -raw weka_password_secret_id)" \
  #       --query SecretString --output text
  #
  # then base64 it. Pipe carefully -- `... --output text | base64` is correct
  # only because --output text does not add a trailing newline; if in doubt,
  # copy the value and use printf.
  password: UkVQTEFDRV9XSVRIX0FETUlOX1BBU1NXT1JE
