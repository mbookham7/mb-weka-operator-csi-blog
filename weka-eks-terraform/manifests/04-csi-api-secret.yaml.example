# ---------------------------------------------------------------------------
# WEKA CSI API credentials  (secret #2 of 2)
# ---------------------------------------------------------------------------
# THIS IS A DIFFERENT SECRET FROM 01-weka-client-secret.yaml.
#
# Read that again, because conflating the two is the single most common reason
# a first deployment gets a healthy WekaClient and a PVC stuck in Pending.
#
#   01-weka-client-secret.yaml   Used by: the weka-in-container CLIENT process
#                                Referenced by: spec.wekaSecretRef on the
#                                               WekaClient CR
#                                Job: authenticate and JOIN the cluster's data
#                                     path as a stateless client
#                                Distinctive key: join-secret
#
#   this file (03)               Used by: the CSI controller and node plugins
#                                Referenced by: the eight
#                                  csi.storage.k8s.io/*-secret-name/namespace
#                                  parameters on the StorageClass (04)
#                                Job: call the WEKA REST API over HTTPS to
#                                     create / expand / delete filesystem
#                                     directories backing PVCs
#                                Distinctive keys: endpoints, scheme
#
# Note the key names differ too: `org` in 01 versus `organization` here. They
# are not typos and they are not interchangeable.
#
# Copy to 04-csi-api-secret.yaml (gitignored) and fill in.
# EVERY VALUE IS BASE64, and use printf, never echo:
#
#     printf '%s' 'the-value' | base64
---
apiVersion: v1
kind: Secret
metadata:
  name: csi-wekafs-api-secret
  # Must match the *-secret-namespace parameters in 05-storageclass-dir.yaml.
  namespace: weka-operator-system
type: Opaque
data:
  # --- username ----------------------------------------------------------
  # WEKA user the CSI plugin authenticates as. "admin" works; a dedicated
  # account limited to filesystem management is better practice, since these
  # credentials are readable by anything that can read Secrets in this
  # namespace.
  #   printf '%s' 'admin' | base64
  username: YWRtaW4=

  # --- password ----------------------------------------------------------
  #   aws secretsmanager get-secret-value --region <region> \
  #     --secret-id "$(terraform output -raw weka_password_secret_id)" \
  #     --query SecretString --output text
  password: UkVQTEFDRV9XSVRIX0FETUlOX1BBU1NXT1JE

  # --- organization ------------------------------------------------------
  # "Root" for a module-built cluster. NOTE the key is `organization` here,
  # while the client secret in 01 calls the same concept `org`.
  #   printf '%s' 'Root' | base64
  organization: Um9vdA==

  # --- scheme ------------------------------------------------------------
  # http or https. HTTPS IS MANDATORY from WEKA 4.3.0 onward -- the backend
  # simply does not serve the API over plain HTTP any more, so an `http` value
  # here produces connection failures that look like a network or security
  # group problem rather than a configuration one.
  #
  # The module-built cluster uses a self-signed certificate. If the CSI plugin
  # rejects it, add the CA in PEM form as a base64 `caCertificate` key below.
  #   printf '%s' 'https' | base64
  scheme: aHR0cHM=

  # --- endpoints ---------------------------------------------------------
  # Comma-separated WEKA management API endpoints, each <ip>:14000. Port 14000
  # is the WEKA REST API and it is TCP -- covered by the shared security group
  # in security-groups.tf.
  #
  # LIST AT LEAST TWO. The CSI plugin picks one and fails over; with a single
  # endpoint, one backend being recycled by the module's healing Lambdas takes
  # all provisioning down. Three is better.
  #
  # Get the current IPs with:
  #     terraform output -raw weka_backend_ips_command | bash
  #
  # Then build the value in one shot so you cannot introduce a stray newline
  # or a space after a comma -- both of which produce a value that decodes
  # fine and fails to parse:
  #
  #     printf '%s' '10.0.1.10:14000,10.0.1.11:14000,10.0.1.12:14000' | base64
  #
  # If a PVC hangs in Pending, decode this key and look at it before anything
  # else:
  #     kubectl -n weka-operator-system get secret csi-wekafs-api-secret \
  #       -o jsonpath='{.data.endpoints}' | base64 -d; echo
  endpoints: MTAuMC4xLjEwOjE0MDAwLDEwLjAuMS4xMToxNDAwMCwxMC4wLjEuMTI6MTQwMDA=

  # --- autoUpdateEndpoints -----------------------------------------------
  # "true" or "false", base64. When true, the plugin refreshes the endpoint
  # list from the cluster on first connection and on every re-login.
  #
  # SET THIS TO true FOR THIS DEPLOYMENT. The WEKA backends are in an
  # autoscaling group with healing Lambdas that replace failed instances, so
  # the IPs you hard-code above WILL go stale. Auto-update lets the plugin
  # track the cluster's real membership instead.
  #
  # Set it to false only if you put a load balancer in front of the API
  # (create_weka_alb = true), where the LB address is the stable one and the
  # backend IPs behind it are not what you want the plugin using.
  #   printf '%s' 'true' | base64
  autoUpdateEndpoints: dHJ1ZQ==

  # --- optional ----------------------------------------------------------
  # NFS target IPs -- only for NFS-transport mounts. Leave empty for the
  # DPDK/WekaClient path this repo uses.
  nfsTargetIps: ""

  # Base64-encoded PEM CA bundle, if the cluster's API certificate is not
  # trusted by the CSI plugin's default trust store.
  caCertificate: ""
